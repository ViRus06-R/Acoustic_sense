# Copy to .env.local and adjust. All values have working defaults for the local demo.

# Postgres connection. `npm run db` serves a local PGlite Postgres on this URL.
# To use a real PostgreSQL server instead, point this at it (and set DB_POOL_MAX=10).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DB_POOL_MAX=4

# Backend MQTT credentials (needed only when the broker requires auth, see docs/broker.md).
# Broker host/port/TLS are set in Settings > MQTT and broker.
MQTT_USERNAME=
MQTT_PASSWORD=

# Base URL used in emailed links (dev-mail/*.eml).
APP_URL=http://localhost:3000

# Demo password applied by `npm run seed` (DEMO ONLY).
DEMO_PASSWORD=AcousticDemo#2026
